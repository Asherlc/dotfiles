{
  "permissions": {
    "allow": [
      "Shell(ls)",
      "Shell(find)",
      "Shell(head)",
      "Mcp(codegraph:codegraph_explore)",
      "Shell(git status)",
      "Shell(git log)",
      "Shell(git branch)",
      "Shell(gh)",
      "Shell(tail)",
      "Shell(echo)",
      "Shell(python3)"
    ],
    "deny": []
  },
  "version": 1,
  "editor": {
    "vimMode": false
  },
  "display": {
    "showLineNumbers": false,
    "showThinkingBlocks": false,
    "showStatusIndicators": false,
    "showStatusLineRunningTime": false,
    "mode": "zen"
  },
  "notifications": true,
  "hints": true,
  "modelSlashCommands": true,
  "steering": true,
  "rewind": true,
  "model": {
    "modelId": "default",
    "displayModelId": "auto",
    "displayName": "Auto",
    "displayNameShort": "Auto",
    "aliases": [
      "auto"
    ],
    "maxMode": false
  },
  "hasChangedDefaultModel": false,
  "modelParameters": {
    "default": [],
