# Reviewed example: keep credentials and local machine paths out of Git.
model = "gpt-6.1-sol"
model_reasoning_effort = "high"
approvals_reviewer = "user"

service_tier = "default"

[plugins."github@openai-curated"]
enabled = true

[plugins."sentry@openai-curated"]
enabled = true

[plugins."superpowers@openai-curated"]
enabled = true

[plugins."browser@openai-bundled"]
enabled = true

[plugins."visualize@openai-bundled"]
enabled = true

[plugins."documents@openai-primary-runtime"]
enabled = true

[plugins."pdf@openai-primary-runtime"]
enabled = true

[plugins."spreadsheets@openai-primary-runtime"]
enabled = true

[plugins."presentations@openai-primary-runtime"]
enabled = true

[plugins."template-creator@openai-primary-runtime"]
enabled = true

[plugins."computer-use@openai-bundled"]
enabled = true

[plugins."chrome@openai-bundled"]
enabled = true

[plugins."codex-app-tools@openai-bundled"]
enabled = true

[plugins."unified-computer-use@openai-bundled"]
enabled = true

[plugins."tokeneconomizer@tokeneconomizer"]
enabled = true

[mcp_servers.openaiDeveloperDocs]
url = "https://developers.openai.com/mcp"

[mcp_servers.openaiDeveloperDocs.tools.fetch_openai_doc]
approval_mode = "approve"

[mcp_servers.openaiDeveloperDocs.tools.search_openai_docs]
approval_mode = "approve"

[mcp_servers.axiom]
url = "https://mcp.axiom.co/mcp"

[mcp_servers.sentry]
url = "https://mcp.sentry.dev/mcp"

[mcp_servers.context7]
command = "npx"
args = ["-y", "@upstash/context7-mcp"]

[mcp_servers.chrome-devtools]
command = "npx"
args = ["chrome-devtools-mcp@latest"]

[mcp_servers.posthog]
url = "https://mcp.posthog.com/mcp"

[mcp_servers.codegraph]
command = "codegraph"
args = ["serve", "--mcp"]

[mcp_servers.render]
url = "https://mcp.render.com/mcp"

[mcp_servers.render.oauth]
client_id = "codex"

[mcp_servers.firefox-devtools]
command = "npx"
args = ["-y", "@mozilla/firefox-devtools-mcp-moz@latest"]

[mcp_servers.usda_foods]
url = "https://usda.caseyjhand.com/mcp"

[mcp_servers.figma-tidy-moth]
url = "https://mcp.figma.com/mcp"

[mcp_servers.1password-tidy-moth]
command = "/Applications/1Password.app/Contents/MacOS/1password-mcp"

[mcp_servers.cloudflare]
url = "https://mcp.cloudflare.com/mcp"

[mcp_servers.backblaze-b2]
command = "/Users/asherlc/.local/share/mise/installs/node/26/bin/node"
args = ["/Users/asherlc/.local/share/mise/installs/node/26/lib/node_modules/npm/bin/npx-cli.js", "-y", "@backblaze-labs/b2-mcp@0.2.2", "stdio"]

[mcp_servers.backblaze-b2.env]
B2_APPLICATION_KEY = "REPLACE_LOCALLY"
B2_APPLICATION_KEY_ID = "REPLACE_LOCALLY"
PATH = "/Users/asherlc/.local/share/mise/installs/node/26/bin:/opt/homebrew/bin:/usr/bin:/bin"

[mcp_servers.gitguardian]
url = "https://mcp.gitguardian.com/mcp"

[desktop]
followUpQueueMode = "queue"
dock-icon-preference = "codex-system"
keepRemoteControlAwakeWhilePluggedIn = true
git-pr-instructions = "Monitor the PR for CI. if it fails, fix it, and monitor again. if it passes, mark it as ready for review. monitor it for CR comments. address and resolve as they come in."
enabled-reasoning-efforts = ["low", "medium", "high", "xhigh", "ultra", "max"]
conversationDetailMode = "STEPS_PROSE"

[desktop.open-in-target-preferences]
global = "cursor"

[features]
js_repl = false
